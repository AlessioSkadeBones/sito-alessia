---
import Layout from '../layouts/Layout.astro';

const caseStudies = [
  {
    label: 'Case study anonimo',
    sector: 'Abbigliamento',
    period: '2019-2026',
    title: 'Da zero a 4 milioni di fatturato online con Meta Ads.',
    intro:
      'Un brand di abbigliamento partiva con una presenza online ancora poco sviluppata e pochi clienti acquisiti dal digitale. L\'obiettivo era costruire un canale di vendita stabile, aumentare gli acquisti e far crescere una base clienti fidelizzata.',
    results: [
      { value: '€4M', label: 'fatturato online generato in 5 anni' },
      { value: '€1.5M+', label: 'budget Meta gestito' },
      { value: '2019-2026', label: 'collaborazione continuativa' },
    ],
    challenge: [
      'Pochi clienti acquisiti online.',
      'Necessita di trasformare Meta Ads in un canale stabile di vendita.',
      'Bisogno di aumentare non solo le prime vendite, ma anche la fidelizzazione dei clienti.',
    ],
    work: [
      'Struttura campagne Meta orientata alla vendita online.',
      'Gestione e ottimizzazione progressiva del budget pubblicitario.',
      'Lavoro su acquisizione nuovi clienti e ritorno dei clienti già acquisiti.',
      'Analisi continuativa dei risultati per decidere dove scalare e dove ridurre dispersione.',
    ],
    outcome:
      'Il lavoro ha permesso al brand di costruire un canale di vendita digitale partendo da zero, arrivando a 4 milioni di euro di fatturato online in 5 anni attraverso campagne Meta continuative e un presidio costante delle performance.',
  },
];
---

<Layout
  title="Case Study"
  description="Case study e risultati concreti ottenuti da Alessio Cervara con campagne Meta Ads per brand italiani."
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow hero-reveal" style="animation-delay: 0ms">Case study</p>
      <h1 class="hero-title hero-reveal" style="animation-delay: 150ms">
        Risultati reali, raccontati senza gonfiare i numeri.
      </h1>
      <p class="hero-sub hero-reveal" style="animation-delay: 300ms">
        Alcuni progetti non possono essere mostrati con il nome del brand. Quando serve, li racconto in forma anonima, mantenendo chiari contesto, lavoro svolto e risultati.
      </p>
    </div>
  </section>

  <section class="cases">
    <div class="container">
      {
        caseStudies.map((study) => (
          <article class="case-detail animate-fade-up">
            <div class="case-head">
              <div>
                <p class="case-label">{study.label}</p>
                <h2>{study.title}</h2>
                <p class="case-intro">{study.intro}</p>
              </div>
              <div class="case-meta">
                <div>
                  <span>Settore</span>
                  <strong>{study.sector}</strong>
                </div>
                <div>
                  <span>Periodo</span>
                  <strong>{study.period}</strong>
                </div>
                <div>
                  <span>Canale</span>
                  <strong>Meta Ads</strong>
                </div>
              </div>
            </div>

            <div class="result-grid animate-stagger">
              {study.results.map((result) => (
                <div class="result-card animate-stagger-item">
                  <span>{result.value}</span>
                  <p>{result.label}</p>
                </div>
              ))}
            </div>

            <div class="case-body">
              <section>
                <p class="section-kicker">Problema iniziale</p>
                <ul>
                  {study.challenge.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
              <section>
                <p class="section-kicker">Intervento</p>
                <ul>
                  {study.work.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
              <section class="outcome">
                <p class="section-kicker">Risultato</p>
                <p>{study.outcome}</p>
              </section>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="final-cta">
    <div class="container cta-inner animate-fade-up">
      <h2>Vuoi capire se posso ottenere un risultato simile sul tuo progetto?</h2>
      <p>Raccontami da dove parti: budget, obiettivi, canali attivi e principali problemi.</p>
      <a href="/contatti">Parliamone</a>
    </div>
  </section>
</Layout>

<style>
  .eyebrow,
  .case-label,
  .section-kicker {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mid);
  }

  .hero {
    padding: 6rem 0 5rem;
    border-bottom: 1px solid var(--color-divider);
  }
  .hero-inner {
    max-width: 820px;
  }
  .eyebrow {
    margin-bottom: 1.5rem;
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4.75rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.025em;
    margin-bottom: 1.5rem;
  }
  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.75;
    max-width: 680px;
  }

  .cases {
    padding: 6rem 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .case-detail {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
  .case-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 5rem;
    align-items: start;
  }
  .case-label {
    color: var(--color-accent);
    margin-bottom: 1rem;
  }
  .case-head h2 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.75rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.025em;
    max-width: 760px;
    margin-bottom: 1.25rem;
  }
  .case-intro {
    font-size: 1rem;
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.85;
    max-width: 700px;
  }
  .case-meta {
    border-top: 1px solid var(--color-divider);
  }
  .case-meta div {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .case-meta span {
    display: block;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mid);
    margin-bottom: 0.35rem;
  }
  .case-meta strong {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 400;
  }

  .result-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-divider);
    border-left: 1px solid var(--color-divider);
  }
  .result-card {
    min-height: 180px;
    padding: 2rem;
    border-right: 1px solid var(--color-divider);
    border-bottom: 1px solid var(--color-divider);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .result-card span {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1;
    color: var(--color-accent);
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
  }
  .result-card p {
    font-size: 0.85rem;
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.55;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .case-body {
    display: grid;
    grid-template-columns: 1fr 1fr 1.2fr;
    gap: 3rem;
  }
  .section-kicker {
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }
  .case-body ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .case-body li {
    display: flex;
    gap: 0.65rem;
    font-size: 0.92rem;
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.65;
  }
  .case-body li::before {
    content: '—';
    color: var(--color-divider);
    flex-shrink: 0;
  }
  .outcome p:last-child {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.45;
  }

  .final-cta {
    padding: 7rem 0;
  }
  .cta-inner {
    max-width: 620px;
  }
  .cta-inner h2 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.025em;
    margin-bottom: 1.25rem;
  }
  .cta-inner p {
    font-size: 1rem;
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.75;
    margin-bottom: 2rem;
  }
  .cta-inner a {
    display: inline-flex;
    background: var(--color-accent);
    color: #fff;
    padding: 0.875rem 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    transition: opacity 0.2s ease;
  }
  .cta-inner a:hover {
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .case-head,
    .case-body {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .result-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 4rem 0 3.5rem;
    }
    .cases {
      padding: 4rem 0;
    }
    .case-detail {
      gap: 3rem;
    }
    .result-card {
      min-height: 150px;
      padding: 1.5rem;
    }
    .final-cta {
      padding: 5rem 0;
    }
  }
</style>
