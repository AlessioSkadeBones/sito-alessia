---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Meta Ads Specialist"
  description="Alessio Cervara — Meta & Pinterest Ads Specialist per e-commerce italiani. €3M+ di budget gestito per brand moda, lusso e lifestyle."
>

  <!-- ═══════════════════════════════════════════
       HERO  (animazione al caricamento, non scroll)
  ═══════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d?w=1600&q=80&auto=format&fit=crop"
        alt=""
        class="hero-bg-img"
        loading="eager"
      />
    </div>
    <div class="container">
      <p class="eyebrow hero-reveal" style="animation-delay: 0ms">Alessio Cervara · Meta &amp; Pinterest Ads Specialist</p>
      <h1 class="hero-headline hero-reveal" style="animation-delay: 150ms">
        Meta Ads per brand<br />
        che vogliono vendere<br />
        <em>senza disperdere budget.</em>
      </h1>
      <p class="hero-sub hero-reveal" style="animation-delay: 300ms">Strategia, creatività, ottimizzazione e lettura dei dati per trasformare le campagne in un canale stabile di acquisizione.</p>
      <div class="hero-ctas hero-reveal" style="animation-delay: 450ms">
        <a href="/contatti" class="btn-primary">Parliamoci</a>
        <a href="/case-study" class="btn-ghost">Guarda i risultati →</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CLIENTI
  ═══════════════════════════════════════════ -->
  <section class="clients animate-fade-up">
    <div class="container">
      <p class="clients-label">Hanno lavorato con me</p>
      <p class="clients-names">One Cashmere · Mason's · Emma Silk · Le Trecce di Nina · Mimmù · Sportlife · Galuja</p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       STAT
  ═══════════════════════════════════════════ -->
  <section class="stats">
    <div class="container">
      <div class="stats-grid animate-stagger">
        <div class="stat animate-stagger-item">
          <span
            class="stat-number animate-count"
            data-count-target="10"
            data-count-suffix="+"
          >10+</span>
          <span class="stat-label">anni di esperienza</span>
        </div>
        <div class="stat animate-stagger-item">
          <span
            class="stat-number animate-count"
            data-count-prefix="€"
            data-count-target="3"
            data-count-suffix="M+"
          >€3M+</span>
          <span class="stat-label">di budget gestito</span>
        </div>
        <div class="stat animate-stagger-item">
          <span
            class="stat-number animate-count"
            data-count-target="8"
          >8</span>
          <span class="stat-label">brand attivi seguiti</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       POSIZIONAMENTO
  ═══════════════════════════════════════════ -->
  <section class="positioning">
    <div class="container positioning-grid">
      <div class="positioning-copy animate-fade-up">
        <p class="section-label">Per chi è</p>
        <h2 class="section-headline">
          Per brand che vogliono crescere senza bruciare budget.
        </h2>
      </div>
      <div class="positioning-body animate-stagger">
        <p class="animate-stagger-item">
          Lavoro con e-commerce, brand moda e lifestyle, attività locali e business che hanno già un'offerta validata e vogliono trasformare Meta Ads in un canale stabile di acquisizione.
        </p>
        <p class="animate-stagger-item">
          Non mi limito a "gestire campagne": entro nei numeri, nella proposta commerciale, nelle creatività e nel percorso che porta una persona da primo contatto ad acquisto.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SERVIZI
  ═══════════════════════════════════════════ -->
  <section class="services">
    <div class="container">
      <p class="section-label animate-fade-up">Cosa faccio</p>
      <ul class="services-list animate-stagger">
        <li class="animate-stagger-item">
          <a href="/servizi#meta-ads-ecommerce" class="service-row">
            <span class="service-copy">
              <span class="service-name">Meta Ads E-commerce</span>
              <span class="service-desc">Campagne, creatività e ottimizzazione pensate per vendere prodotti online.</span>
            </span>
            <span class="service-arrow">→</span>
          </a>
        </li>
        <li class="animate-stagger-item">
          <a href="/servizi#meta-ads-local" class="service-row">
            <span class="service-copy">
              <span class="service-name">Meta Ads Local Business</span>
              <span class="service-desc">Acquisizione clienti, lead e prenotazioni per attività locali con obiettivi misurabili.</span>
            </span>
            <span class="service-arrow">→</span>
          </a>
        </li>
        <li class="animate-stagger-item">
          <a href="/servizi#pinterest-ads" class="service-row">
            <span class="service-copy">
              <span class="service-name">Pinterest Ads</span>
              <span class="service-desc">Un canale visivo da affiancare a Meta per brand moda, lifestyle e prodotti ad alto impatto estetico.</span>
            </span>
            <span class="service-arrow">→</span>
          </a>
        </li>
        <li class="animate-stagger-item">
          <a href="/servizi#social-media-management" class="service-row">
            <span class="service-copy">
              <span class="service-name">Social Media Management</span>
              <span class="service-desc">Contenuti organici coordinati con la strategia advertising, per dare coerenza al brand.</span>
            </span>
            <span class="service-arrow">→</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PROBLEMI
  ═══════════════════════════════════════════ -->
  <section class="problems">
    <div class="container problems-grid">
      <div class="problems-heading animate-fade-up">
        <p class="section-label">Problemi che risolvo</p>
        <h2 class="section-headline">Quando le campagne girano, ma non danno risposte chiare.</h2>
      </div>
      <div class="problems-list animate-stagger">
        <div class="problem-row animate-stagger-item">
          <span>Risultati instabili</span>
          <p>Campagne che alternano giornate buone e giornate vuote, senza una lettura chiara di cosa stia succedendo.</p>
        </div>
        <div class="problem-row animate-stagger-item">
          <span>Budget che non scala</span>
          <p>Aumenti l'investimento, ma il fatturato non cresce in proporzione o il costo per acquisizione peggiora.</p>
        </div>
        <div class="problem-row animate-stagger-item">
          <span>Creatività poco efficaci</span>
          <p>Annunci curati dal punto di vista estetico, ma deboli su hook, promessa, prova sociale e intenzione d'acquisto.</p>
        </div>
        <div class="problem-row animate-stagger-item">
          <span>Report poco operativi</span>
          <p>Tanti numeri, poche decisioni. Il punto non è guardare dashboard, ma capire cosa fare dopo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       COSA GUARDO
  ═══════════════════════════════════════════ -->
  <section class="diagnosis">
    <div class="container">
      <div class="diagnosis-header animate-fade-up">
        <p class="section-label">Dove intervengo</p>
        <h2 class="section-headline">Le campagne sono solo una parte del lavoro.</h2>
      </div>
      <div class="diagnosis-grid animate-stagger">
        <article class="diagnosis-item animate-stagger-item">
          <span class="diagnosis-num">01</span>
          <h3>Account e struttura</h3>
          <p>Controllo campagne, budget, tracciamento, eventi, pubblici e segnali che l'algoritmo sta usando per ottimizzare.</p>
        </article>
        <article class="diagnosis-item animate-stagger-item">
          <span class="diagnosis-num">02</span>
          <h3>Offerta e funnel</h3>
          <p>Valuto se il messaggio pubblicitario, la landing, il prodotto e il percorso d'acquisto stanno lavorando nella stessa direzione.</p>
        </article>
        <article class="diagnosis-item animate-stagger-item">
          <span class="diagnosis-num">03</span>
          <h3>Creatività e angoli</h3>
          <p>Creo una direzione di test: hook, formati, promesse, prove sociali e contenuti pensati per vendere, non solo per essere belli.</p>
        </article>
        <article class="diagnosis-item animate-stagger-item">
          <span class="diagnosis-num">04</span>
          <h3>Numeri e decisioni</h3>
          <p>Leggo i risultati in base al margine, al ciclo d'acquisto e agli obiettivi reali. Non tutti i ROAS raccontano la stessa storia.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       COME LAVORO
  ═══════════════════════════════════════════ -->
  <section class="how">
    <div class="container">
      <h2 class="how-headline animate-fade-up">Come lavoro.</h2>
      <span class="animate-line" aria-hidden="true"></span>
      <div class="how-steps animate-stagger">
        <div class="how-step animate-stagger-item">
          <span class="step-num">01</span>
          <div class="step-body">
            <h3 class="step-title">Analisi</h3>
            <p class="step-desc">Prima capisco il tuo business, i dati e gli obiettivi. Nessuna campagna parte senza una base solida.</p>
          </div>
        </div>
        <div class="how-step animate-stagger-item">
          <span class="step-num">02</span>
          <div class="step-body">
            <h3 class="step-title">Strategia e creatività</h3>
            <p class="step-desc">Definisco struttura, angoli creativi e messaggi. La creatività è il targeting.</p>
          </div>
        </div>
        <div class="how-step animate-stagger-item">
          <span class="step-num">03</span>
          <div class="step-body">
            <h3 class="step-title">Ottimizzazione continua</h3>
            <p class="step-desc">Monitoro, testo e miglioro ogni settimana. Le decisioni le prendo sui dati, non a sensazione.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       COSA INCLUDE
  ═══════════════════════════════════════════ -->
  <section class="included">
    <div class="container included-grid">
      <div class="included-heading animate-fade-up">
        <p class="section-label">Nel lavoro mensile</p>
        <h2 class="section-headline">Una gestione chiara, con priorità e prossime azioni.</h2>
      </div>
      <div class="included-list animate-stagger">
        <div class="included-row animate-stagger-item">
          <span>Strategia campagne</span>
          <p>Struttura account, obiettivi, budget, pubblici e piano di test mensile.</p>
        </div>
        <div class="included-row animate-stagger-item">
          <span>Direzione creativa</span>
          <p>Angoli, hook, messaggi, brief per asset e lettura delle creatività che stanno funzionando.</p>
        </div>
        <div class="included-row animate-stagger-item">
          <span>Ottimizzazione</span>
          <p>Controllo performance, riallocazione budget e interventi su campagne, annunci e funnel.</p>
        </div>
        <div class="included-row animate-stagger-item">
          <span>Report operativo</span>
          <p>Risultati, insight e azioni successive spiegati in modo semplice, senza dashboard inutili.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CASE STUDY PREVIEW
  ═══════════════════════════════════════════ -->
  <section class="cases">
    <div class="container">
      <div class="cases-header animate-fade-up">
        <p class="section-label">Risultati recenti</p>
        <a href="/case-study" class="cases-all">Vedi tutti →</a>
      </div>
      <div class="cases-grid animate-stagger">
        <a href="/case-study" class="case-card animate-stagger-item">
          <div class="case-img-wrap">
            <img
              src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=800&q=80&auto=format&fit=crop"
              alt="Campagna Meta Ads luxury fashion — One Cashmere"
              class="case-img"
              loading="lazy"
            />
          </div>
          <p class="case-brand">One Cashmere</p>
          <p class="case-sector">Cashmere lusso · Meta Ads + Pinterest</p>
          <p class="case-result">+43%<span>ROAS</span></p>
          <p class="case-desc">Ridefinizione completa della struttura campagne e angoli creativi per un brand premium nel segmento lusso.</p>
        </a>
        <a href="/case-study" class="case-card animate-stagger-item">
          <div class="case-img-wrap">
            <img
              src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=800&q=80&auto=format&fit=crop"
              alt="Campagna Meta Ads abbigliamento — Mason's"
              class="case-img"
              loading="lazy"
            />
          </div>
          <p class="case-brand">Mason's</p>
          <p class="case-sector">Abbigliamento · Meta Ads + Pinterest</p>
          <p class="case-result">-38%<span>CPR</span></p>
          <p class="case-desc">Ottimizzazione del costo per risultato attraverso broad targeting e test creativi sistematici.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CTA FINALE
  ═══════════════════════════════════════════ -->
  <section class="final-cta">
    <div class="container final-cta-inner animate-fade-up">
      <h2 class="final-cta-headline">Pronto a scalare?</h2>
      <p class="final-cta-sub">Raccontami il tuo progetto.</p>
      <a href="/contatti" class="btn-primary">Parliamoci</a>
    </div>
  </section>

</Layout>

<style>
  /* ─── SHARED ──────────────────────────────── */
  .eyebrow,
  .section-label {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mid);
    margin-bottom: 1.5rem;
  }

  /* ─── HERO ────────────────────────────────── */
  .hero {
    padding: 7rem 0 6rem;
    border-bottom: 1px solid var(--color-divider);
    position: relative;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    opacity: 0.88;
  }
  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero .container {
    position: relative;
    z-index: 1;
  }
  .hero .eyebrow {
    margin-bottom: 2rem;
  }
  .hero-headline {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 2rem;
    max-width: 14ch;
  }
  .hero-headline em {
    font-style: italic;
    color: var(--color-mid);
  }
  .hero-sub {
    font-size: 1rem;
    color: var(--color-mid);
    font-weight: 300;
    margin-bottom: 3rem;
    max-width: 420px;
  }
  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }
  .btn-primary {
    display: inline-block;
    padding: 0.875rem 2rem;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    transition: opacity 0.2s;
  }
  .btn-primary:hover { opacity: 0.85; }
  .btn-ghost {
    font-size: 0.9rem;
    color: var(--color-text);
    font-weight: 400;
    transition: color 0.2s;
  }
  .btn-ghost:hover { color: var(--color-accent); }

  /* ─── CLIENTS ─────────────────────────────── */
  .clients {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .clients .container {
    display: flex;
    align-items: baseline;
    gap: 2.5rem;
    flex-wrap: wrap;
  }
  .clients-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mid);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .clients-names {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-text);
    letter-spacing: 0.01em;
    line-height: 1.6;
  }

  /* ─── STATS ───────────────────────────────── */
  .stats {
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  .stat {
    padding: 0 3rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-right: 1px solid var(--color-divider);
  }
  .stat:first-child { padding-left: 0; }
  .stat:last-child { border-right: none; }
  .stat-number {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--color-accent);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat-label {
    font-size: 0.8rem;
    color: var(--color-mid);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  /* ─── POSITIONING ─────────────────────────── */
  .positioning,
  .diagnosis,
  .included {
    padding: 6rem 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .positioning-grid,
  .included-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 5rem;
    align-items: start;
  }
  .section-headline {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.75rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.025em;
    max-width: 720px;
  }
  .positioning-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 0.25rem;
  }
  .positioning-body p {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.85;
    max-width: 620px;
  }

  /* ─── SERVICES ────────────────────────────── */
  .services {
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .services-list {
    list-style: none;
    border-top: 1px solid var(--color-divider);
  }
  .service-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-divider);
    transition: opacity 0.2s;
  }
  .service-row:hover { opacity: 0.5; }
  .service-copy {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-right: 2rem;
  }
  .service-name {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .service-desc {
    font-size: 0.875rem;
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.65;
    max-width: 560px;
  }
  .service-arrow {
    font-size: 1.25rem;
    color: var(--color-mid);
    transition: transform 0.2s, color 0.2s;
    flex-shrink: 0;
  }
  .service-row:hover .service-arrow {
    transform: translateX(4px);
    color: var(--color-accent);
  }

  /* ─── PROBLEMS ────────────────────────────── */
  .problems {
    padding: 6rem 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .problems-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 5rem;
    align-items: start;
  }
  .problems-list {
    border-top: 1px solid var(--color-divider);
  }
  .problem-row {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 2rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .problem-row span {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--color-text);
  }
  .problem-row p {
    font-size: 0.9rem;
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.75;
  }

  /* ─── DIAGNOSIS ───────────────────────────── */
  .diagnosis-header {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 5rem;
    margin-bottom: 4rem;
    align-items: start;
  }
  .diagnosis-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--color-divider);
    border-left: 1px solid var(--color-divider);
  }
  .diagnosis-item {
    min-height: 280px;
    padding: 2rem;
    border-right: 1px solid var(--color-divider);
    border-bottom: 1px solid var(--color-divider);
    display: flex;
    flex-direction: column;
  }
  .diagnosis-num {
    font-family: var(--font-serif);
    color: var(--color-accent);
    font-style: italic;
    margin-bottom: 2.5rem;
  }
  .diagnosis-item h3 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
  }
  .diagnosis-item p {
    font-size: 0.875rem;
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.75;
  }

  /* ─── HOW I WORK ──────────────────────────── */
  .how {
    padding: 6rem 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .how-headline {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    margin-bottom: 2rem;
  }
  .how-steps {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-divider);
  }
  .how-step {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 2rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--color-divider);
    align-items: start;
  }
  .step-num {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-accent);
    font-style: italic;
    padding-top: 0.2rem;
