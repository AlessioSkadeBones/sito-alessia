---
import Layout from '../layouts/Layout.astro';

interface Package {
  name: string;
  description: string;
  features: string[];
  featured?: boolean;
  specialFirst?: boolean;
}

const mainPackages: Package[] = [
  {
    name: 'Essential',
    description: 'Il punto di partenza per chi vuole campagne Meta strutturate e monitorate con costanza.',
    features: [
      'Gestione strategica di 1 canale principale (Meta Ads)',
      'Pianificazione mensile delle priorità pubblicitarie',
      'Ottimizzazione campagne e controllo budget',
      'Report mensile sintetico con risultati e prossime azioni',
      'Comunicazione asincrona e 1 call strategica mensile',
      'Budget ADV escluso dalla fee',
    ],
  },
  {
    name: 'Growth',
    description: 'Per chi vuole scalare. Strategia, direzione creativa e ottimizzazione continua su Meta Ads.',
    features: [
      'Gestione strategica campagne Meta Ads',
      'Direzione creativa: angoli, offerte, hook e test',
      'Coordinamento tra piano editoriale e campagne advertising',
      'Ottimizzazione continuativa di campagne, pubblici, creatività e budget',
      "Report mensile con analisi, insight e piano d'azione",
      '1 call strategica settimanale',
      'Budget ADV escluso dalla fee',
    ],
    featured: true,
  },
  {
    name: 'Performance',
    description: 'Full-funnel, test strutturati e monitoraggio ravvicinato. Per chi vuole il massimo.',
    features: [
      'Tutto incluso nel Growth',
      'Strategia full-funnel: acquisizione, retargeting e conversione',
      'Test creativi e commerciali strutturati',
      'Revisione landing page, sito o funnel con indicazioni operative',
      'Priorità operativa e monitoraggio ravvicinato',
      '1 call strategica settimanale',
      'Budget ADV escluso dalla fee',
    ],
    specialFirst: true,
  },
  {
    name: 'Social Media Management',
    description: 'Gestione editoriale completa dei canali organici, coordinata con la strategia advertising.',
    features: [
      'Gestione editoriale dei canali social organici',
      'Piano editoriale mensile con rubriche, format e calendario',
      'Copywriting per post, reel, stories e contenuti ricorrenti',
      'Coordinamento con asset del cliente o creator esterni',
      'Programmazione e pubblicazione contenuti',
      'Report mensile con insight e prossime azioni',
      'Produzione foto/video e grafiche avanzate escluse',
    ],
  },
  {
    name: 'Full Marketing',
    description: 'Meta Ads, Google Ads e social organici coordinati in un unico piano mensile integrato.',
    features: [
      'Gestione coordinata Meta Ads, Google Ads e social organici',
      'Strategia mensile integrata tra acquisizione, contenuti e remarketing',
      'Coordinamento operativo dei professionisti coinvolti',
      'Piano editoriale mensile con priorità e format',
      'Report mensile unico con risultati e prossime azioni',
      '1 call strategica settimanale',
      'Budget ADV, produzione e tool esterni esclusi',
    ],
  },
];

const addons = [
  {
    name: 'AI Business Starter',
    tag: 'Una tantum',
    description:
      'Analisi e setup degli strumenti AI più utili per il tuo business, con formazione pratica per il team.',
    features: [
      'Analisi processi e individuazione attività automatizzabili',
      'Setup strumenti AI per marketing, contenuti, customer care o vendite',
      'Creazione prompt, procedure e workflow per il team',
      'Formazione pratica sugli strumenti configurati',
      'Documento operativo finale con istruzioni e sviluppi consigliati',
    ],
  },
];

const startingPoints = [
  {
    label: 'Hai già campagne attive, ma risultati poco stabili',
    suggestion: 'Parti da Growth: serve continuità su struttura, creatività e ottimizzazione.',
  },
  {
    label: 'Stai iniziando e vuoi una gestione ordinata',
    suggestion: 'Essential è il punto giusto per avere metodo, controllo budget e priorità chiare.',
  },
  {
    label: 'Vuoi integrare advertising, organico e direzione marketing',
    suggestion: 'Full Marketing o Performance hanno più senso se il problema non è solo Meta Ads.',
  },
];

const faqs = [
  {
    question: 'Il budget pubblicitario è incluso?',
    answer: 'No. La fee copre strategia, gestione, ottimizzazione e report. Il budget ADV resta separato e viene investito direttamente dagli account del cliente.',
  },
  {
    question: 'Quanto dura una collaborazione?',
    answer: 'Lavoro meglio su orizzonti di almeno tre mesi: il primo serve a leggere dati e sistemare le basi, i successivi a validare test e migliorare le decisioni.',
  },
  {
    question: 'Ti occupi anche delle creatività?',
    answer: 'Mi occupo della direzione creativa: hook, angoli, brief, messaggi e lettura dei risultati. La produzione foto/video avanzata si valuta a parte.',
  },
  {
    question: 'Se non so quale pacchetto scegliere?',
    answer: 'Nessun problema. Mi racconti il progetto e ti indico la soluzione più adatta, anche se significa partire da qualcosa di più semplice.',
  },
];

const serviceDetails = [
  {
    id: 'meta-ads-ecommerce',
    eyebrow: 'Meta Ads E-commerce',
    title: 'Campagne pensate per vendere prodotti, non solo per generare traffico.',
    body: 'Lavoro su struttura account, creatività, offerte, catalogo, retargeting e lettura dei margini. L\'obiettivo è capire quali campagne portano fatturato sostenibile e quali stanno solo consumando budget.',
    fit: ['Brand con uno shop già attivo', 'Prodotti con margini e offerta chiari', 'Bisogno di rendere Meta un canale più stabile'],
    work: ['Audit account e tracking', 'Piano test creativi e commerciali', 'Ottimizzazione campagne e budget', 'Report con prossime azioni'],
  },
  {
    id: 'meta-ads-local',
    eyebrow: 'Meta Ads Local Business',
    title: 'Lead, prenotazioni e richieste da persone vicine al tuo business.',
    body: 'Per attività locali lavoro su messaggi chiari, pubblico corretto, offerte credibili e percorsi semplici: l\'obiettivo non è avere più like, ma più contatti utili.',
    fit: ['Attivita con area geografica definita', 'Obiettivi come lead, prenotazioni o richieste', 'Necessita di misurare meglio il costo contatto'],
    work: ['Strategia local e obiettivi', 'Campagne lead o traffico qualificato', 'Creatività e copy orientati alla richiesta', 'Lettura dei contatti generati'],
  },
  {
    id: 'social-media-management',
    eyebrow: 'Social Media Management',
    title: 'Contenuti organici coordinati con la strategia advertising.',
    body: 'Non tratto i social organici come un calendario da riempire. Lavoro su rubriche, messaggi, formati e coerenza con ciò che le campagne stanno comunicando.',
    fit: ['Brand che vogliono una presenza più coerente', 'Necessità di coordinare organico e paid', 'Team che ha asset ma manca di direzione editoriale'],
    work: ['Piano editoriale mensile', 'Rubriche, copy e format', 'Coordinamento con campagne advertising', 'Report con insight e prossime azioni'],
  },
];
---

<Layout
  title="Servizi"
  description="I pacchetti di collaborazione di Alessio Cervara: Meta Ads, Social Media Management, Full Marketing e servizi aggiuntivi per e-commerce italiani."
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <div class="hero-inner">
        <p class="eyebrow hero-reveal" style="animation-delay: 0ms">Servizi</p>
        <h1 class="page-title hero-reveal" style="animation-delay: 150ms">
          Scegli come vuoi<br />lavorare insieme.
        </h1>
        <p class="page-subtitle hero-reveal" style="animation-delay: 300ms">
          Ogni pacchetto è pensato per una fase diversa di crescita.<br />
          Nessuna soluzione unica per tutti — solo quello che serve davvero.
        </p>
      </div>
    </div>
  </section>

  <!-- Service details -->
  <section class="service-details">
    <div class="container">
      <div class="service-details-heading animate-fade-up">
        <p class="eyebrow">Aree di intervento</p>
        <h2 class="section-title">Ogni servizio ha obiettivi, segnali e priorità diverse.</h2>
      </div>
      <div class="service-detail-list animate-stagger">
        {
          serviceDetails.map((service) => (
            <article id={service.id} class="service-detail animate-stagger-item">
              <div class="service-detail-main">
                <p class="service-detail-eyebrow">{service.eyebrow}</p>
                <h3>{service.title}</h3>
                <p>{service.body}</p>
                <a href="/contatti" class="service-detail-cta">Parliamone</a>
              </div>
              <div class="service-detail-side">
                <div>
                  <span>Per chi è</span>
                  <ul>
                    {service.fit.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <span>Cosa lavoro</span>
                  <ul>
                    {service.work.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Starting point -->
  <section class="starting">
    <div class="container starting-grid">
      <div class="starting-heading animate-fade-up">
        <p class="eyebrow">Da dove partire</p>
        <h2 class="section-title">Il servizio giusto dipende dal punto in cui sei adesso.</h2>
      </div>
      <div class="starting-list animate-stagger">
        {
          startingPoints.map((item) => (
            <article class="starting-row animate-stagger-item">
              <h3>{item.label}</h3>
              <p>{item.suggestion}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Main Packages -->
  <section class="packages">
    <div class="container">
      <div class="packages-grid animate-stagger">
        {
          mainPackages.map((pkg) => (
            <article class:list={['pkg-card', 'animate-stagger-item', { featured: pkg.featured }]}>
              {pkg.featured && <span class="badge">Consigliato</span>}
              <div class="card-head">
                <h3 class="pkg-name">{pkg.name}</h3>
                <p class="pkg-desc">{pkg.description}</p>
              </div>
              <ul class="features">
                {pkg.features.map((f, i) => (
                  <li class:list={[{ special: pkg.specialFirst && i === 0 }]}>{f}</li>
                ))}
              </ul>
              <a
                href="/contatti"
                class:list={['pkg-cta', { 'pkg-cta-filled': pkg.featured }]}
              >
                Parliamoci
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Visual break -->
  <section class="visual-break">
    <div class="container">
      <div class="visual-img-wrap">
        <img
          src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1400&q=80&auto=format&fit=crop"
          alt="Analytics e dati campagne advertising su laptop"
          class="visual-img"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Add-ons -->
  <section class="addons">
    <div class="container">
      <h2 class="addons-title animate-fade-up">Servizi aggiuntivi</h2>
      <div class="addons-grid animate-stagger">
        {
          addons.map((addon) => (
            <article class="addon-card animate-stagger-item">
              <div class="addon-head">
                <span class="addon-tag">{addon.tag}</span>
                <h3 class="addon-name">{addon.name}</h3>
                <p class="addon-desc">{addon.description}</p>
              </div>
              <ul class="features features-sm">
                {addon.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <a href="/contatti" class="pkg-cta">Parliamoci</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="container faq-grid">
      <div class="faq-heading animate-fade-up">
        <p class="eyebrow">Domande frequenti</p>
        <h2 class="section-title">Prima di scegliere, chiariamo le cose importanti.</h2>
      </div>
      <div class="faq-list animate-stagger">
        {
          faqs.map((faq) => (
            <article class="faq-item animate-stagger-item">
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta">
    <div class="container">
      <div class="cta-inner animate-fade-up">
        <p class="cta-eyebrow">Hai dubbi?</p>
        <h2 class="cta-title">
          Non sai quale pacchetto<br />fa per te?
        </h2>
        <p class="cta-body">
          Raccontami il tuo progetto, valutiamo insieme la soluzione più adatta.
        </p>
        <a href="/contatti" class="cta-btn">Prenota una call gratuita</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero ─────────────────────────────────────────── */
  .page-hero {
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--color-divider);
  }

  .hero-inner {
    max-width: 720px;
  }

  .eyebrow {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mid);
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    letter-spacing: -0.025em;
    line-height: 1.08;
    font-weight: 400;
    margin-bottom: 1.5rem;
  }

  .page-subtitle {
    font-size: 1rem;
    font-weight: 300;
    color: var(--color-mid);
    line-height: 1.75;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  /* ── Service details ─────────────────────────────── */
  .service-details {
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .service-details-heading {
    max-width: 760px;
    margin-bottom: 3.5rem;
  }

  .service-detail-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-divider);
  }

  .service-detail {
    scroll-margin-top: 96px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    gap: 5rem;
    padding: 3rem 0;
    border-bottom: 1px solid var(--color-divider);
    align-items: start;
  }

  .service-detail-eyebrow {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .service-detail-main h3 {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.025em;
    max-width: 720px;
    margin-bottom: 1.25rem;
  }

  .service-detail-main > p {
    font-size: 1rem;
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.85;
    max-width: 620px;
  }

  .service-detail-cta {
    display: inline-flex;
    margin-top: 1.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    padding-bottom: 1px;
    border-bottom: 1px solid var(--color-text);
    transition: opacity 0.2s ease;
  }
  .service-detail-cta:hover {
    opacity: 0.5;
  }

  .service-detail-side {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .service-detail-side > div {
    border: 1px solid var(--color-divider);
    padding: 1.5rem;
    min-height: 100%;
  }

  .service-detail-side span {
    display: block;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mid);
    margin-bottom: 1rem;
  }

  .service-detail-side ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .service-detail-side li {
    display: flex;
    gap: 0.55rem;
    font-size: 0.85rem;
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.55;
  }

  .service-detail-side li::before {
    content: '—';
    color: var(--color-divider);
    flex-shrink: 0;
  }

  /* ── Starting point ──────────────────────────────── */
  .starting,
  .faq {
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .starting-grid,
  .faq-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 5rem;
    align-items: start;
  }

  .starting-list,
  .faq-list {
    border-top: 1px solid var(--color-divider);
  }

  .starting-row,
  .faq-item {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .starting-row h3,
  .faq-item h3 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: 0.65rem;
  }

  .starting-row p,
  .faq-item p {
    font-size: 0.9rem;
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.75;
  }

  /* ── Packages grid ────────────────────────────────── */
  .packages {
    padding: 5rem 0 6rem;
    border-bottom: 1px solid var(--color-divider);
  }

  .packages-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
  }

  .pkg-card {
    flex: 0 0 calc((100% - 3rem) / 3);
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--color-divider);
    padding: 2rem 2.25rem 2.25rem;
    transition: border-color 0.2s ease;
  }

  .pkg-card:hover:not(.featured) {
    border-color: var(--color-mid);
  }

  .pkg-card.featured {
    border-color: var(--color-accent);
    background-color: rgba(194, 74, 44, 0.03);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    background-color: var(--color-accent);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.28rem 0.6rem;
    border-radius: 2px;
    margin-bottom: 1.25rem;
  }

  .card-head {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-divider);
  }

  .pkg-name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    font-weight: 400;
    margin-bottom: 0.6rem;
    line-height: 1.2;
  }

  .pkg-desc {
    font-size: 0.875rem;
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.65;
  }

  /* ── Feature list ─────────────────────────────────── */
  .features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.845rem;
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.55;
  }

  .features li::before {
    content: '—';
    color: var(--color-divider);
    flex-shrink: 0;
    font-size: 0.8rem;
    padding-top: 0.1rem;
  }

  .features li.special {
    font-style: italic;
    font-weight: 400;
    color: var(--color-text);
  }

  .features li.special::before {
    content: '+';
    color: var(--color-accent);
    font-style: normal;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .features-sm li {
    font-size: 0.845rem;
  }

  /* ── Card CTA ─────────────────────────────────────── */
  .pkg-cta {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    padding-bottom: 1px;
    border-bottom: 1px solid var(--color-text);
    margin-top: 2rem;
    letter-spacing: 0.01em;
    transition: opacity 0.2s ease;
  }
  .pkg-cta:hover {
    opacity: 0.5;
  }

  .pkg-cta-filled {
    background-color: var(--color-accent);
    color: #fff;
    padding: 0.7rem 1.5rem;
    border: none;
    border-bottom: none;
    border-radius: 2px;
  }
  .pkg-cta-filled:hover {
    opacity: 0.85;
  }

  /* ── Visual break ────────────────────────────────── */
  .visual-break {
    padding: 0 0 5rem;
    border-bottom: 1px solid var(--color-divider);
  }
  .visual-img-wrap {
    width: 100%;
    height: 340px;
    overflow: hidden;
    border: 1px solid var(--color-divider);
  }
  .visual-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ── Add-ons ──────────────────────────────────────── */
  .addons {
    padding: 5rem 0 6rem;
    border-bottom: 1px solid var(--color-divider);
  }

  .addons-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    letter-spacing: -0.02em;
    font-weight: 400;
    margin-bottom: 2.5rem;
  }

  .addons-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .addon-card {
    border: 1px solid var(--color-divider);
    padding: 2rem 2.25rem 2.25rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease;
  }
  .addon-card:hover {
    border-color: var(--color-mid);
  }

  .addon-head {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-divider);
  }

  .addon-tag {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mid);
    margin-bottom: 0.65rem;
  }

  .addon-name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    font-weight: 400;
    margin-bottom: 0.6rem;
    line-height: 1.2;
  }

  .addon-desc {
    font-size: 0.875rem;
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.65;
  }

  /* ── Final CTA ────────────────────────────────────── */
  .final-cta {
