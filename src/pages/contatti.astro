---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contatti" description="Contatta Alessio Cervara per una valutazione gratuita del tuo progetto Meta Ads. Risposta entro 24 ore.">

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow hero-reveal" style="animation-delay: 0ms">Contatti</p>
      <h1 class="hero-headline hero-reveal" style="animation-delay: 150ms">Parliamoci.</h1>
      <p class="hero-sub hero-reveal" style="animation-delay: 300ms">Raccontami il tuo progetto. Ti rispondo entro 24 ore con una valutazione onesta su come posso aiutarti.</p>
    </div>
  </section>

  <!-- FORM + INFO -->
  <section class="main">
    <div class="container main-inner">

      <!-- FORM -->
      <div class="form-col animate-fade-up">
        <form id="contact-form" novalidate>

          <div class="field-row">
            <div class="field">
              <label for="nome">Nome e cognome <span class="req">*</span></label>
              <input type="text" id="nome" name="nome" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="email">Email <span class="req">*</span></label>
              <input type="email" id="email" name="email" required autocomplete="email" />
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="brand">Nome del brand / azienda <span class="req">*</span></label>
              <input type="text" id="brand" name="brand" required />
            </div>
            <div class="field">
              <label for="settore">Settore <span class="req">*</span></label>
              <input type="text" id="settore" name="settore" placeholder="es. moda, food, sport, altro" required />
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="servizio">Servizio di interesse</label>
              <div class="select-wrap">
                <select id="servizio" name="servizio">
                  <option value="">— Seleziona —</option>
                  <option>Meta Ads</option>
                  <option>Google Ads</option>
                  <option>Social Media Management</option>
                  <option>Full Marketing</option>
                  <option>AI Business Starter</option>
                  <option>Non so ancora</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label for="budget">Budget mensile attuale in advertising</label>
              <div class="select-wrap">
                <select id="budget" name="budget">
                  <option value="">— Seleziona —</option>
                  <option>Non ho ancora budget</option>
                  <option>Meno di €500</option>
                  <option>€500 - €1.500</option>
                  <option>€1.500 - €5.000</option>
                  <option>Oltre €5.000</option>
                </select>
              </div>
            </div>
          </div>

          <div class="field">
            <label for="messaggio">Messaggio <span class="req">*</span></label>
            <textarea id="messaggio" name="messaggio" rows="6" placeholder="Raccontami il tuo progetto, obiettivi e sfide attuali." required></textarea>
          </div>

          <div id="form-feedback" class="feedback" aria-live="polite"></div>

          <button type="submit" id="submit-btn" class="btn-submit">
            <span id="btn-label">Invia richiesta</span>
            <span id="btn-loading" hidden>Invio in corso…</span>
          </button>

        </form>
      </div>

      <!-- INFO -->
      <aside class="info-col animate-stagger">
        <div class="info-block animate-stagger-item">
          <p class="info-label">Email</p>
          <a href="mailto:alessiocervara@live.it" class="info-value">alessiocervara@live.it</a>
        </div>
        <div class="info-block animate-stagger-item">
          <p class="info-label">LinkedIn</p>
          <a href="https://www.linkedin.com/in/alessiocervara" target="_blank" rel="noopener noreferrer" class="info-value">linkedin.com/in/alessiocervara →</a>
        </div>
        <div class="info-note animate-stagger-item">
          <p>Preferisci una call diretta? Scrivimi su LinkedIn o via email per fissare 30 minuti gratuiti.</p>
        </div>
        <div class="info-img-wrap animate-stagger-item">
          <img
            src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=600&q=80&auto=format&fit=crop"
            alt="Spazio di lavoro professionale e minimalista"
            class="info-img"
            loading="lazy"
          />
        </div>
      </aside>

    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnLabel = document.getElementById('btn-label') as HTMLSpanElement;
  const btnLoading = document.getElementById('btn-loading') as HTMLSpanElement;
  const feedback = document.getElementById('form-feedback') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Reset
    feedback.textContent = '';
    feedback.className = 'feedback';

    // Loading state
    submitBtn.disabled = true;
    btnLabel.hidden = true;
    btnLoading.hidden = false;

    try {
      const data = new FormData(form);
      const res = await fetch('https://formspree.io/f/mlgzkobk', {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.reset();
        feedback.textContent = 'Grazie! Ho ricevuto la tua richiesta. Ti rispondo entro 24 ore.';
        feedback.classList.add('feedback--success');
      } else {
        const json = await res.json().catch(() => ({}));
        const msg = (json as any)?.errors?.map((err: any) => err.message).join(', ');
        throw new Error(msg || 'Errore durante l\'invio.');
      }
    } catch (err: any) {
      feedback.textContent = err.message || 'Qualcosa è andato storto. Riprova o scrivimi via email.';
      feedback.classList.add('feedback--error');
    } finally {
      submitBtn.disabled = false;
      btnLabel.hidden = false;
      btnLoading.hidden = true;
    }
  });
</script>

<style>
  .eyebrow {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mid);
    margin-bottom: 1.5rem;
  }

  /* HERO */
  .hero {
    padding: 6rem 0 4rem;
    border-bottom: 1px solid var(--color-divider);
  }
  .hero-headline {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }
  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.7;
    max-width: 520px;
  }

  /* MAIN LAYOUT */
  .main {
    padding: 5rem 0 7rem;
  }
  .main-inner {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 5rem;
    align-items: start;
  }

  /* FORM */
  .form-col {
    min-width: 0;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  label {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-text);
  }
  .req {
    color: var(--color-accent);
  }
  input,
  textarea,
  select {
    width: 100%;
    background: transparent;
    border: 1px solid var(--color-divider);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 300;
    padding: 0.75rem 1rem;
    outline: none;
    transition: border-color 0.2s;
    appearance: none;
    -webkit-appearance: none;
    border-radius: 0;
  }
  input::placeholder,
  textarea::placeholder {
    color: var(--color-mid);
    opacity: 0.7;
  }
  input:focus,
  textarea:focus,
  select:focus {
    border-color: var(--color-text);
  }
  textarea {
    resize: vertical;
    min-height: 140px;
  }
  .select-wrap {
    position: relative;
  }
  .select-wrap::after {
    content: '↓';
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-mid);
    font-size: 0.75rem;
    pointer-events: none;
  }
  select {
    cursor: pointer;
    padding-right: 2.5rem;
  }
  select option {
    background: #F7F4EE;
    color: var(--color-text);
  }

  /* FEEDBACK */
  .feedback {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    min-height: 1.4rem;
  }
  .feedback--success {
    color: #2d6a4f;
  }
  .feedback--error {
    color: var(--color-accent);
  }

  /* BUTTON */
  .btn-submit {
    display: inline-block;
    padding: 0.9rem 2.25rem;
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s;
    border-radius: 0;
  }
  .btn-submit:hover {
    opacity: 0.85;
  }
  .btn-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* INFO SIDEBAR */
  .info-col {
    padding-top: 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .info-block {
    border-top: 1px solid var(--color-divider);
    padding-top: 1.25rem;
  }
  .info-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mid);
    margin-bottom: 0.4rem;
  }
  .info-value {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-text);
    transition: color 0.2s;
    word-break: break-all;
  }
  .info-value:hover {
    color: var(--color-accent);
  }
  .info-note {
    border-top: 1px solid var(--color-divider);
    padding-top: 1.25rem;
  }
  .info-note p {
    font-size: 0.875rem;
    color: var(--color-mid);
    font-weight: 300;
    line-height: 1.75;
  }
  .info-img-wrap {
    border: 1px solid var(--color-divider);
    overflow: hidden;
    margin-top: 0.5rem;
  }
  .info-img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .info-img-wrap:hover .info-img { transform: scale(1.03); }

  /* MOBILE */
  @media (max-width: 900px) {
    .main-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .info-col {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1.5rem;
    }
    .info-block,
    .info-note {
      flex: 1 1 200px;
    }
  }
  @media (max-width: 600px) {
    .hero {
      padding: 4rem 0 3rem;
    }
    .main {
      padding: 3.5rem 0 5rem;
    }
    .field-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .info-col {
      flex-direction: column;
    }
  }
</style>
