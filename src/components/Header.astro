---
const navLinks = [
  { href: '/servizi', label: 'Servizi' },
  { href: '/case-study', label: 'Case Study' },
  { href: '/chi-sono', label: 'Chi Sono' },
  { href: '/contatti', label: 'Contatti' },
];
---

<header class="header">
  <div class="container">
    <a href="/" class="logo" aria-label="Alessio Cervara — Home">
      <span class="logo-mark" aria-hidden="true">
        A<span class="logo-mark-c">C</span>
      </span>
      <span class="logo-text">
        <strong>Alessio Cervara</strong>
        <span>Meta Ads Specialist</span>
      </span>
    </a>

    <nav class="nav" id="main-nav" aria-label="Navigazione principale">
      <ul class="nav-links">
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
      <a href="/contatti" class="cta">Parliamoci</a>
    </nav>

    <button
      class="burger"
      id="burger"
      aria-expanded="false"
      aria-controls="main-nav"
      aria-label="Apri menu di navigazione"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  const burger = document.getElementById('burger');
  const nav = document.getElementById('main-nav');

  burger?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    burger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    burger.classList.toggle('active', isOpen);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-divider);
  }

  .header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }
  .logo:hover { opacity: 0.65; }
  .logo-mark {
    font-family: var(--font-serif);
    font-size: 2.1rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-text);
    display: inline-block;
    padding: 0.15rem 0 0;
  }
  .logo-mark-c {
    color: var(--color-accent);
    margin-left: -0.18em;
    font-style: italic;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    line-height: 1.1;
  }
  .logo-text strong {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .logo-text span {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-mid);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2.25rem;
  }

  .nav-links a {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-mid);
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }
  .nav-links a:hover { color: var(--color-text); }

  .cta {
    background-color: var(--color-accent);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.55rem 1.2rem;
    letter-spacing: 0.02em;
    transition: opacity 0.2s ease;
    border-radius: 2px;
    white-space: nowrap;
  }
  .cta:hover { opacity: 0.85; }

  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }
  .burger span {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: var(--color-text);
    transition: all 0.25s ease;
    transform-origin: center;
  }
  .burger.active span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .burger.active span:nth-child(2) {
    opacity: 0;
  }
  .burger.active span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .logo-mark {
      font-size: 1.75rem;
    }
    .logo-text span {
      display: none;
    }
    .nav {
      display: none;
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      background-color: var(--color-bg);
      border-bottom: 1px solid var(--color-divider);
      padding: 1.75rem 1.25rem 2rem;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.75rem;
    }
    .nav.open { display: flex; }
    .nav-links { flex-direction: column; gap: 1.25rem; }
    .nav-links a { font-size: 1.1rem; color: var(--color-text); }
    .burger { display: flex; }
  }
</style>
