---
import { hasIubendaCookieBanner, legalConfig } from '../config/legal';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Alessio Cervara — Home">
          <img src="/logo.png" alt="Alessio Cervara" class="footer-logo-img" height="52" />
        </a>
        <h2 class="footer-name">Alessio Cervara</h2>
        <p class="footer-tagline">
          Meta &amp; Pinterest Ads Specialist per e-commerce, brand lifestyle e local business italiani.
        </p>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        <p class="footer-nav-label">Navigazione</p>
        <ul>
          <li><a href="/servizi">Servizi</a></li>
          <li><a href="/case-study">Case Study</a></li>
          <li><a href="/chi-sono">Chi Sono</a></li>
          <li><a href="/contatti">Contatti</a></li>
        </ul>
      </nav>

      <div class="footer-contact">
        <p class="footer-nav-label">Contatti</p>
        <a href="mailto:alessiocervara@live.it">alessiocervara@live.it</a>
        <a
          href="https://www.linkedin.com/in/alessiocervara"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn →
        </a>
      </div>

      <div class="footer-legal">
        <p class="footer-nav-label">Policy</p>
        <a
          href={legalConfig.privacyPolicyUrl || '#'}
          class:list={[
            'iubenda-nostyle no-brand iubenda-noiframe iubenda-embed',
            { 'is-disabled': !legalConfig.privacyPolicyUrl },
          ]}
          title="Privacy Policy"
          aria-disabled={!legalConfig.privacyPolicyUrl}
        >
          Privacy Policy
        </a>
        <a
          href={legalConfig.cookiePolicyUrl || '#'}
          class:list={[
            'iubenda-nostyle no-brand iubenda-noiframe iubenda-embed',
            { 'is-disabled': !legalConfig.cookiePolicyUrl },
          ]}
          title="Cookie Policy"
          aria-disabled={!legalConfig.cookiePolicyUrl}
        >
          Cookie Policy
        </a>
        <button
          type="button"
          class="footer-cookie-prefs"
          data-cookie-preferences
          disabled={!hasIubendaCookieBanner}
        >
          Preferenze cookie
        </button>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} Alessio Cervara — P.IVA 01426400451 — Carrara (MS)</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-divider);
    padding: 4rem 0 2.5rem;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: 0.75rem;
    transition: opacity 0.2s ease;
  }
  .footer-logo:hover { opacity: 0.65; }
  .footer-logo-img {
    display: block;
    height: 52px;
    width: auto;
  }
  .footer-name {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--color-mid);
    line-height: 1.6;
    font-weight: 300;
    max-width: 360px;
  }

  .footer-nav-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mid);
    margin-bottom: 1rem;
  }

  .footer-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-nav a,
  .footer-contact a,
  .footer-legal a,
  .footer-cookie-prefs {
    font-size: 0.875rem;
    color: var(--color-mid);
    transition: color 0.2s ease;
    display: block;
  }
  .footer-nav a:hover,
  .footer-contact a:hover,
  .footer-legal a:hover,
  .footer-cookie-prefs:hover {
    color: var(--color-text);
  }

  .footer-contact,
  .footer-legal {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .footer-contact .footer-nav-label,
  .footer-legal .footer-nav-label {
    margin-bottom: 1rem;
  }
  .footer-cookie-prefs {
    padding: 0;
    border: none;
    background: transparent;
    font-family: var(--font-sans);
    text-align: left;
    cursor: pointer;
  }
  .footer-legal .is-disabled,
  .footer-cookie-prefs:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid var(--color-divider);
  }

  .footer-bottom p {
    font-size: 0.78rem;
    color: var(--color-mid);
    letter-spacing: 0.01em;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
