---
const cases = [
  {
    brand: 'One Cashmere',
    sector: 'Cashmere Lusso · E-commerce',
    result: '+43% ROAS in 60 giorni',
    description:
      'Ristrutturazione completa della struttura campagne, passaggio a broad targeting e nuova strategia creativa stagionale. Budget mantenuto invariato.',
  },
  {
    brand: "Mason's",
    sector: 'Abbigliamento · E-commerce',
    result: 'CPA -38% a parità di volume',
    description:
      "Ottimizzazione del funnel di acquisto e sistema di creative testing strutturato su campagne Advantage+. Riduzione del costo per acquisto mantenendo lo stesso volume di conversioni.",
  },
];
---

<section class="case-preview">
  <div class="container">
    <header class="section-header">
      <h2 class="section-title">Risultati recenti</h2>
      <p class="section-sub">Non promesse — numeri reali, con contesto reale.</p>
    </header>

    <div class="grid">
      {cases.map((c) => (
        <article class="card">
          <div class="card-inner">
            <div>
              <p class="card-sector">{c.sector}</p>
              <h3 class="card-brand">{c.brand}</h3>
            </div>

            <div class="result-box">
              <span class="result-label">Risultato chiave</span>
              <span class="result-value">{c.result}</span>
            </div>

            <p class="card-description">{c.description}</p>

            <a href="/case-study" class="card-link">
              Leggi il case study →
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="section-footer">
      <a href="/case-study" class="view-all">Tutti i case study →</a>
    </div>
  </div>
</section>

<style>
  .case-preview {
    padding: 7rem 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .section-header {
    max-width: 600px;
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    font-weight: 400;
  }

  .section-sub {
    font-size: 1rem;
    color: var(--color-mid);
    font-weight: 300;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    margin-bottom: 2rem;
  }

  .card {
    border: 1px solid var(--color-divider);
    transition: border-color 0.2s ease;
  }
  .card:hover {
    border-color: var(--color-mid);
  }

  .card-inner {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    height: 100%;
  }

  .card-sector {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mid);
    margin-bottom: 0.45rem;
  }

  .card-brand {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    letter-spacing: -0.02em;
    font-weight: 400;
    line-height: 1.1;
  }

  .result-box {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem 1.5rem;
    background-color: rgba(194, 74, 44, 0.05);
    border-left: 2px solid var(--color-accent);
  }

  .result-label {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mid);
  }

  .result-value {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-accent);
    letter-spacing: -0.01em;
    font-style: italic;
  }

  .card-description {
    font-size: 0.875rem;
    color: var(--color-mid);
    line-height: 1.75;
    font-weight: 300;
    flex: 1;
  }

  .card-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    padding-bottom: 1px;
    border-bottom: 1px solid var(--color-text);
    align-self: flex-start;
    transition: opacity 0.2s ease;
    letter-spacing: 0.01em;
  }
  .card-link:hover { opacity: 0.5; }

  .section-footer {
    display: flex;
    justify-content: flex-end;
  }

  .view-all {
    font-size: 0.875rem;
    color: var(--color-mid);
    transition: color 0.2s ease;
  }
  .view-all:hover { color: var(--color-text); }

  @media (max-width: 768px) {
    .case-preview {
      padding: 4.5rem 0;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .card-inner {
      padding: 1.75rem;
    }
  }
</style>
